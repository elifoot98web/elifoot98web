{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/assets/elifoot/**"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/(icon|pwaicons|splash)/**",
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    },
    {
      "name": "jsdos",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/js-dos/js-dos.js",
          "/assets/js-dos/js-dos.css",
          "/assets/js-dos/wdosbox.js",
          "/assets/js-dos/wdosbox.wasm",
          "/assets/js-dos/emulators-ui-loader.png"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "icons",
      "urls": ["/svg/**"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 300,
        "maxAge": "365d"
      }
    }
  ]
}
